# Directorio donde están los dumps de la base de datos:
#   usuarios_drm.sql
#   otros_ingresos.sql
#
# Puede ser una ruta relativa al repositorio o una ruta absoluta.
# Si la ruta tiene espacios, debe ir entre comillas.
#
# Ejemplo en esta máquina:
# DUMP_DIR="/home/adalid/Documents/DiscoDFM/DB OTROS INGRESOS"
DUMP_DIR=./docker/dumps

# Password de root de MySQL. Debe coincidir con la que usa la aplicación.
MYSQL_ROOT_PASSWORD=cysgodion
